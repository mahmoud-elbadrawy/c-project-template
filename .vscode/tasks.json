{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake -S . -B build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake --build build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Reconfigure + Build",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Clean Build Files",
            "type": "shell",
            "command": "cmake -E rm -rf build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Run Application",
            "type": "shell",
            "command": "./build/c-project-template",
            "problemMatcher": []
        },
        {
            "label": "Ceedling: Run All Tests",
            "type": "shell",
            "command": "ceedling test:all",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Ceedling: Clean",
            "type": "shell",
            "command": "ceedling clean",
            "problemMatcher": []
        },
        {
            "label": "Ceedling: Clobber",
            "type": "shell",
            "command": "ceedling clobber",
            "problemMatcher": []
        }
    ]
}
